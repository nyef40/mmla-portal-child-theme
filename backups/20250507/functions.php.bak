<?php
// Blocksy Child Theme: Custom Functions

// Suppress notices temporarily during debugging
error_reporting(E_ALL & ~E_NOTICE);

add_action('init', function() {
    load_theme_textdomain('blocksy', get_template_directory() . '/languages');
    if (function_exists('wpforms')) {
        load_plugin_textdomain('wpforms', false, dirname(plugin_basename(WPFORMS_PLUGIN_FILE)) . '/languages/');
    }
}, 100);

// WPForms Process Complete: Set Validation URL Transient and Store Submission
add_action('wpforms_process_complete', function($fields, $entry, $form_data, $entry_id) {
    if ($form_data['id'] == 1479) {
        $validation_token = wp_generate_uuid4();
        $validation_url = add_query_arg([
            'action' => 'validate_email',
            'token' => $validation_token,
            'submission_id' => $entry_id,
        ], home_url());
        $result = set_transient('wpforms_validation_url_' . $entry_id, $validation_url, 2 * HOUR_IN_SECONDS);
        error_log('Process filter: Validation URL set for entry ' . $entry_id . ': ' . $validation_url . ', Result: ' . ($result ? 'Success' : 'Failed'), 3, WP_CONTENT_DIR . '/debug.log');
        // Verify transient
        $verify_url = get_transient('wpforms_validation_url_' . $entry_id);
        error_log('Process filter: Transient verification for entry ' . $entry_id . ': ' . ($verify_url ?: 'Not found'), 3, WP_CONTENT_DIR . '/debug.log');

        // Log all fields for debugging
        error_log('Form fields for entry ' . $entry_id . ': ' . print_r($fields, true), 3, WP_CONTENT_DIR . '/debug.log');
        error_log('Provider Email (ID 15) for entry ' . $entry_id . ': ' . ($fields[15]['value'] ?? 'Not set'), 3, WP_CONTENT_DIR . '/debug.log');

        // Validate fields before encryption
        $required_fields = [
            2 => 'provider_name',
            14 => 'provider_practice',
            15 => 'provider_email',
            16 => 'provider_phone',
            18 => 'patient_name',
            19 => 'patient_email',
            20 => 'patient_phone',
            21 => 'insurance',
            23 => 'reason',
            24 => 'notes',
        ];
        $data = [];
        foreach ($required_fields as $field_id => $field_name) {
            $value = isset($fields[$field_id]['value']) && $fields[$field_id]['value'] !== '' ? $fields[$field_id]['value'] : '';
            if ($value) {
                $data[$field_name] = base64_encode(openssl_encrypt($value, 'AES-256-CBC', 'mmla_2025', 0, substr(hash('sha256', 'mmla_2025'), 0, 16)));
            } else {
                $data[$field_name] = '';
                error_log('Missing or empty field ' . $field_name . ' (ID: ' . $field_id . ') for entry ' . $entry_id, 3, WP_CONTENT_DIR . '/debug.log');
            }
        }
        $data['validation_token'] = $validation_token;
        $data['created_at'] = current_time('mysql');

        // Insert into database
        global $wpdb;
        $table_name = $wpdb->prefix . 'referral_submissions';
        $wpdb->insert($table_name, $data);
        error_log('Database insertion for entry ' . $entry_id . ': ' . ($wpdb->last_error ?: 'Success'), 3, WP_CONTENT_DIR . '/debug.log');
    }
}, 10, 4);

// Register Custom Smart Tag
add_filter('wpforms_smart_tags', function($tags) {
    $tags['validation_url'] = 'Validation URL';
    error_log('Smart tags filter: Added validation_url', 3, WP_CONTENT_DIR . '/debug.log');
    return $tags;
});

add_filter('wpforms_smart_tag_process_validation_url', function($content, $form_data, $fields, $entry_id) {
    $transient_key = 'wpforms_validation_url_' . $entry_id;
    $validation_url = get_transient($transient_key);
    if (!$validation_url) {
        global $wpdb;
        $validation_url = $wpdb->get_var($wpdb->prepare("SELECT option_value FROM $wpdb->options WHERE option_name = %s", '_transient_' . $transient_key));
        error_log('Smart tag processing: Direct DB check for ' . $transient_key . ': ' . ($validation_url ?: 'Not found'), 3, WP_CONTENT_DIR . '/debug.log');
    }
    error_log('Smart tag processing validation_url for entry ' . $entry_id . ': ' . ($validation_url ?: 'Not found'), 3, WP_CONTENT_DIR . '/debug.log');
    return $validation_url ?: $content;
}, 10, 4);

// Replace CUSTOM_VALIDATION_URL in Email
add_filter('wpforms_emails_send_email_data', function($data, $notifications) {
    $form_data = $notifications->form_data;
    $entry_id = $notifications->entry_id;
    $notification_id = $notifications->notification_id;
    error_log('Emails send email data hook triggered for form ' . $form_data['id'] . ', entry ' . $entry_id . ', notification ' . $notification_id, 3, WP_CONTENT_DIR . '/debug.log');
    error_log('Email recipients: ' . $data['to'], 3, WP_CONTENT_DIR . '/debug.log');
    error_log('Email message before: ' . $data['message'], 3, WP_CONTENT_DIR . '/debug.log');
    if ($form_data['id'] == 1479 && $notification_id == 2) {
        $transient_key = 'wpforms_validation_url_' . $entry_id;
        $validation_url = get_transient($transient_key);
        if (!$validation_url) {
            global $wpdb;
            $validation_url = $wpdb->get_var($wpdb->prepare("SELECT option_value FROM $wpdb->options WHERE option_name = %s", '_transient_' . $transient_key));
            error_log('Emails send email data: Direct DB check for ' . $transient_key . ': ' . ($validation_url ?: 'Not found'), 3, WP_CONTENT_DIR . '/debug.log');
        }
        error_log('Transient key: ' . $transient_key . ', Value: ' . ($validation_url ?: 'Not found'), 3, WP_CONTENT_DIR . '/debug.log');
        if ($validation_url) {
            $data['message'] = str_replace('CUSTOM_VALIDATION_URL', esc_url_raw($validation_url), $data['message']);
            $data['message'] = str_replace('{validation_url}', esc_url_raw($validation_url), $data['message']);
            error_log('Emails send email data: Replaced CUSTOM_VALIDATION_URL with ' . $validation_url . ' for entry ' . $entry_id, 3, WP_CONTENT_DIR . '/debug.log');
        } else {
            error_log('Emails send email data: No validation_url found for entry ' . $entry_id, 3, WP_CONTENT_DIR . '/debug.log');
        }
        error_log('Email message after: ' . $data['message'], 3, WP_CONTENT_DIR . '/debug.log');
    }
    return $data;
}, 100, 2);

// Fallback: Replace in Notifications Message
add_filter('wpforms_emails_notifications_message', function($message, $notifications) {
    if ($notifications->form_data['id'] == 1479 && $notifications->notification_id == 2) {
        $entry_id = $notifications->entry_id;
        $transient_key = 'wpforms_validation_url_' . $entry_id;
        $validation_url = get_transient($transient_key);
        if (!$validation_url) {
            global $wpdb;
            $validation_url = $wpdb->get_var($wpdb->prepare("SELECT option_value FROM $wpdb->options WHERE option_name = %s", '_transient_' . $transient_key));
            error_log('Notifications message filter: Direct DB check for ' . $transient_key . ': ' . ($validation_url ?: 'Not found'), 3, WP_CONTENT_DIR . '/debug.log');
        }
        error_log('Notifications message filter: Processing validation_url for entry ' . $entry_id . ': ' . ($validation_url ?: 'Not found'), 3, WP_CONTENT_DIR . '/debug.log');
        if ($validation_url) {
            $message = str_replace('CUSTOM_VALIDATION_URL', esc_url_raw($validation_url), $message);
            $message = str_replace('{validation_url}', esc_url_raw($validation_url), $message);
            error_log('Notifications message filter: Replaced validation_url with ' . $validation_url, 3, WP_CONTENT_DIR . '/debug.log');
        }
    }
    return $message;
}, 100, 2);
